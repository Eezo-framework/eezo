    cat > "$dir/src/main/scala/app/Index.scala" <<'EOF'
package app

import io.eezo.core.html.*
import io.eezo.http.Assets
import io.eezo.http.Request
import io.eezo.http.Response

/** `app/Index.scala` mounts `GET /`, calling `def index`: the filename is the route.
  *
  * This is a starter page. When you replace it, delete `src/main/resources/assets/welcome.css`,
  * the stylesheet it links, along with it.
  */
object Index {

  private val Docs = "https://eezo.io/docs"

  private val BookModel =
    """package models
      |
      |import io.eezo.core.Id
      |import io.eezo.http.{Form, Resource}
      |
      |case class Book(
      |    id: Id[Book],
      |    title: String,
      |    author: String
      |) derives Form, Resource
      |""".stripMargin

  private def tutorial(number: Int, name: String, path: String, about: String): Html =
    li(
      a(
        Attrs.href := s"$Docs/$path",
        span(Attrs.cls := "number", number.toString),
        span(strong(name), span(about))
      )
    )

  def index(request: Request): Response = {
    val _ = request
    Response.Ok(
      Html.doctype ++ html(
        Attrs.lang := "en",
        head(
          meta(Attrs.charset := "utf-8"),
          meta(Attrs.name := "viewport", Attrs.content := "width=device-width, initial-scale=1"),
          title("eezo"),
          link(Attrs.rel := "stylesheet", Attrs.href := Assets.url("welcome.css"))
        ),
        body(
          main(
            header(
              p(Attrs.cls := "logo", "eezo"),
              h1("it works"),
              p(
                Attrs.cls := "lead",
                "Your application is running. This page lives in ",
                code("src/main/scala/app/Index.scala"),
                ". With ",
                code("eezo dev"),
                " running, change the heading and save, and this tab reloads."
              ),
              nav(
                Attrs.cls := "actions",
                a(Attrs.cls := "button primary", Attrs.href := s"$Docs/tutorials/getting-started", "Start the tutorial"),
                a(Attrs.cls := "button", Attrs.href := Docs, "Read the docs")
              )
            ),
            section(
              h2("Add your first model"),
              p("Create ", code("src/main/scala/models/Book.scala"), ":"),
              pre(code(BookModel)),
              p(
                "Save it and open ",
                code("/books"),
                ": seven CRUD routes from one case class, with the rows in memory until you add a database. ",
                code("eezo routes"),
                " lists them."
              )
            ),
            section(
              h2("Where to go next"),
              p("Read the tutorials in order the first time."),
              ol(
                tutorial(1, "Your first application", "tutorials/getting-started", "Routing, handlers and the dev loop."),
                tutorial(2, "From a case class to seven routes", "tutorials/first-model", "A model, a Postgres table and a migration."),
                tutorial(3, "Adding sign in", "tutorials/sign-in", "Users, a login page, and rows each user owns."),
                tutorial(4, "Deploying to Fly.io", "tutorials/deploy-to-fly", "Ship it with one command, no Dockerfile to write."),
                tutorial(5, "A live page", "tutorials/a-live-page", "Updates in the browser with no JavaScript of yours.")
              )
            ),
            footer(
              a(Attrs.href := s"$Docs/how-to", "How-to guides"),
              a(Attrs.href := s"$Docs/reference", "Reference"),
              a(Attrs.href := s"$Docs/examples/blog", "Example: a blog"),
              a(Attrs.href := "https://github.com/Eezo-framework/eezo", "GitHub")
            )
          )
        )
      )
    )
  }
}
EOF
  fi

  write_agents_note "$dir/AGENTS.md"

  echo "created $name at $(cd -- "$dir" 2> /dev/null && pwd) (eezo $EEZO_VERSION, Scala $SCALA_VERSION, sbt $SBT_VERSION)"
  write_gitignore "$dir/.gitignore"
  echo
  echo "next:"
  [ "$dir" = "." ] || echo "  cd $name"
  echo "  eezo dev           # serve on :8080, restart on save"
  [ "$tailwind" -eq 0 ] || echo "                     # the first build fetches the Tailwind CLI once, into ~/.eezo/tools"
  echo "  eezo routes        # what is mounted"
}

cmd="${1:-}"
case "$cmd" in
  "" | -h | --help)
    usage
    ;;
  new)
    shift
    scaffold "$@"
    ;;
  dev)
    shift
    dev "$@"
    ;;
  build)
    need_sbt
    forward "staging the application" eezoStage
    ;;
  deploy)
    shift
    deploy "$@"
    ;;
  upgrade)
    upgrade
    ;;
  # The schema commands, one namespace forwarded whole: `eezo db sync --apply` is
  # `run db sync --apply`, and `eezo db` alone is the application's own list of them.
  # `db freeze` bypasses the spinner: it prompts on destructive changes, and a prompt behind a
  # spinner is a hang with good intentions.
  db)
    need_sbt
    if [ "${2:-}" = "freeze" ]; then
      forward_live "run $*"
    else
      forward "eezo db ${2:-}" "run $*"
    fi
    ;;
  routes | config | help)
    need_sbt
    forward "eezo $cmd" "run $*"
    ;;
  status | sync | freeze | migrate | reset | drop | dump | ddl)
    echo "eezo: the schema commands live under db: eezo db $*" >&2
    exit 1
    ;;
  *)
    echo "eezo: unknown command '$cmd'" >&2
    usage >&2
    exit 1
    ;;
esac
