#!/usr/bin/env bash
#
# The eezo launcher — layer 3 of design/cli.md §4. It adds no capability, only ergonomics:
# everything except `new` is a forward to the application's own dispatch (`sbt "run <cmd>"`) or to
# an sbt-eezo task, so this script can stay a page long and never needs the user's classpath.
#
# `new` is the one command that cannot forward, because nothing exists yet to forward to. The
# scaffold takes its versions from a file: `.eezo-version` at the repository root when this script
# runs from a checkout (written by `sbt publishLocalForExample`, so a scaffold resolves the locally
# published eezo), and otherwise `~/.eezo/eezo-version`, which the installer at
# https://eezo.io/install writes with the released version.

set -euo pipefail
unset CDPATH

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(dirname "$SCRIPT_DIR")"

usage() {
  cat <<'EOF'
eezo — the framework launcher

  eezo new <name>       scaffold a new application in ./<name>
  eezo new .            scaffold a new application in the current directory, named after it
      --tailwind        with a tailwind.css at the root and the stylesheet linked from the page
  eezo dev              the dev console: serve, restart on save, errors, routes, schema
  eezo build            stage the app for deployment (jars, migrations, Dockerfile)
  eezo deploy           ship it: build, deploy to Fly.io, migrate, wait for health
      --fly             the Fly.io target (the default; long form: --target fly)
      --app <name>      Fly app name (first deploy; required when non-interactive)
  eezo upgrade          move to the latest eezo on Maven Central: this command, what
                        `new` scaffolds, and the project in the current directory

forwarded to the application (run from the project directory):
  eezo routes           what is mounted
  eezo db <command>     the schema commands: status | sync | freeze | migrate |
                        reset | drop | dump | ddl; `eezo db` alone lists them
  eezo help             every command the application answers
  every forwarded command takes --json
EOF
}

need_sbt() {
  command -v sbt > /dev/null || {
    echo "eezo: sbt not found on PATH. Install sbt (https://www.scala-sbt.org) first." >&2
    exit 1
  }
}

# sbt is an implementation detail of the forwarded commands, so its own voice is silenced; the
# application's output passes through untouched (the scaffold sets `run / outputStrategy :=
# StdoutOutput`, so the forked app writes straight to this terminal, not through sbt's logger).
# Three noise sources, each silenced at the narrowest point that gets it:
#
#   - sbt's [info]/[success] chatter: `-error` raises sbt's own log level. Compile errors are
#     [error] and still come through, which is exactly right.
#   - the JDK's Unsafe / native-access WARNING blocks from *sbt's* JVM: turned off with the two
#     flags below rather than filtered, because eezo's own boot warnings reach stderr through
#     java.util.logging with the same "WARNING:" prefix and must not be swallowed. The flags are
#     JDK 23+; eezo's runtime floor is far above that, and sbt runs on the same JVM.
#     SBT_OPTS reaches only sbt's JVM — the forked application gets `run / javaOptions`.
#   - the three "[error] Nonzero exit code" lines sbt prints when the app exits 1: that exit code
#     is the command's *answer* (drift, refusal — design/cli.md), not a failure of the build, so
#     those specific lines are dropped. The app's code is still this script's exit code.

# The spinner: a braille wheel on stderr while a slow step works. Stderr and only when it is a
# TTY, so a redirected stdout (`--json > file`) never receives a spinner byte, and CI logs stay
# clean. The trap clears the line however the script leaves.
SPIN_PID=""

spin_start() {
  [ -t 2 ] || return 0
  (
    frames=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
    i=0
    while :; do
      printf '\r\033[2K%s %s' "${frames[i % 10]}" "$1" >&2
      i=$((i + 1))
      sleep 0.1
    done
  ) &
  SPIN_PID=$!
}

spin_stop() {
  if [ -n "$SPIN_PID" ]; then
    kill "$SPIN_PID" 2> /dev/null || true
    wait "$SPIN_PID" 2> /dev/null || true
    SPIN_PID=""
    printf '\r\033[2K' >&2
  fi
}
trap spin_stop EXIT

sbt_at() { # <level flag> <sbt args...>: sbt with its own JVM's warnings off, at the given level
  SBT_OPTS="${SBT_OPTS:-} --enable-native-access=ALL-UNNAMED --sun-misc-unsafe-memory-access=allow" \
    sbt "$1" -batch "${@:2}"
}

sbt_cmd() { sbt_at -error "$@"; }

# Runs a command under the spinner, streams captured separately (stdout must stay machine-pure),
# replayed by replay_captured afterwards. Returns the command's code.
CAPTURED_OUT=""
CAPTURED_ERR=""

run_captured() { # <label> <command...>
  local label="$1"
  shift
  CAPTURED_OUT="$(mktemp)"
  CAPTURED_ERR="$(mktemp)"
  spin_start "$label"
  set +e
  "$@" > "$CAPTURED_OUT" 2> "$CAPTURED_ERR"
  local code=$?
  set -e
  spin_stop
  return "$code"
}

replay_captured() { # <stdout filter regex, or '' for none>
  if [ -n "$1" ]; then grep -vE "$1" "$CAPTURED_OUT" || true; else cat "$CAPTURED_OUT"; fi
  cat "$CAPTURED_ERR" >&2
  rm -f "$CAPTURED_OUT" "$CAPTURED_ERR"
  CAPTURED_OUT=""
  CAPTURED_ERR=""
}

# The three "[error] Nonzero exit code" lines sbt prints when the app exits 1: that exit code is
# the command's *answer* (drift, refusal — design/cli.md), not a failure of the build, so they are
# dropped; the app's code is still this script's code.
SBT_NOISE='^\[error\] ([Nn]onzero exit code returned from runner|\([^)]*[Rr]un\) [Nn]onzero exit code|Total time:)'

# A forwarded command, spun: sbt works silently behind the wheel, then the app's own output lands
# exactly as it was written, streams intact.
forward() { # <label> <sbt args...>
  local label="$1"
  shift
  local code=0
  run_captured "$label" sbt_cmd "$@" || code=$?
  replay_captured "$SBT_NOISE"
  exit "$code"
}

# The same forward without capture, for the one command that talks back: `freeze` prompts on
# destructive changes, and a prompt behind a spinner is a hang with good intentions.
forward_live() {
  set +e
  sbt_cmd "$@" | grep -vE "$SBT_NOISE"
  local code="${PIPESTATUS[0]}"
  set -e
  exit "$code"
}

# ---------------------------------------------------------------------------------------------
# dev — the console. It lives in the sbt plugin: `eezoDev` is a command of sbt-eezo that owns the
# terminal, watches the sources, compiles, forks the application, and draws a full screen console
# with the log, the compile errors, the route table and the schema drift as panes, and the schema
# commands on keys. So this script hands sbt the terminal and gets out of the way: no pipe, no
# `-batch` (the sbt launcher spells that as `</dev/null`, which would leave the console no
# keyboard), and sbt's own progress bars off. Without a terminal (a pipe, CI) only
# `eezoDev --once` runs, which prints the same events as lines and stops by itself.
#
# A project pinned to an sbt-eezo from before the console (DEV_CONSOLE_SINCE) still has only the
# `~eezoRestart` alias, so for those the console below is built here from sbt's output, as it was
# before: two marker lines from the plugin, sbt's [error] lines, and the application's own
# output. The pin is read off the project, not off this script's checkout: `site/` pins a release
# in its own build even though it sits beside a snapshot.
# ---------------------------------------------------------------------------------------------

DEV_CONSOLE_SINCE="0.4.0"

# Whether the project in the current directory has a plugin with the console command: the
# `sbt-eezo` version it pins, a literal in project/plugins.sbt or, when that line reads
# `EezoVersion.value`, the literal in project/project/EezoVersion.scala, is DEV_CONSOLE_SINCE or
# later. A `+` in the version is a locally published snapshot, always the current plugin, and a
# project that pins neither way (the examples build reads `.eezo-version`) is taken to be current.
dev_console_in_plugin() {
  local pinned
  pinned="$(sed -nE 's/.*"io\.eezo" *% *"sbt-eezo" *% *"([^"]+)".*/\1/p' project/plugins.sbt 2> /dev/null | head -1)"
  [ -n "$pinned" ] ||
    pinned="$(sed -nE 's/.*val value: *String *= *"([^"]+)".*/\1/p' project/project/EezoVersion.scala 2> /dev/null | head -1)"
  [ -n "$pinned" ] || return 0
  case "$pinned" in *+*) return 0 ;; esac
  [ "$(printf '%s\n%s\n' "$DEV_CONSOLE_SINCE" "$pinned" | sort -V | head -1)" = "$DEV_CONSOLE_SINCE" ]
}

dev() {
  need_sbt
  if dev_console_in_plugin; then
    # `--server`: on an sbt 2 project the sbt script runs a thin client by default, and the
    # console must run in the process that owns this terminal.
    SBT_OPTS="${SBT_OPTS:-} --enable-native-access=ALL-UNNAMED --sun-misc-unsafe-memory-access=allow -Dsbt.supershell=false" \
      exec sbt --server -error eezoDev
  fi
  dev_legacy
}

# ---- the console built here, for a project on an older plugin ------------------------------

DEV_STATUS=""
DEV_WATCHING="watching for changes; Ctrl-C stops"

# One line to the console, under the status line when one is showing. The clear and the line go
# out in one write, so the spinner, which redraws every 100 ms, can seldom land between them.
dev_say() {
  if [ -t 2 ]; then printf '\r\033[2K' >&2; fi
  printf '%s\n' "$1"
  if [ -n "$DEV_STATUS" ] && [ -t 2 ]; then printf '  %s' "$DEV_STATUS" >&2; fi
}

# A static status line on stderr; it stays until the next event redraws or clears it.
dev_status() {
  DEV_STATUS="$1"
  if [ -t 2 ]; then printf '\r\033[2K  %s' "$1" >&2; fi
}

# A java.util.logging record header: "<date> <time> <logger class> <method>", no parentheses, so a
# stack frame ("at org.eclipse.jetty.X.y(File.java:1)") never passes for one.
JUL_NOISE='^[^(]* (org\.eclipse\.jetty|com\.zaxxer\.hikari)[A-Za-z0-9_.$]* [A-Za-z0-9_$<>]+$'

dev_console() {
  # The subshell's own trap: a Ctrl-C ends the loop here, and the status line must not be left
  # under the prompt.
  trap 'spin_stop; if [ -t 2 ]; then printf "\r\033[2K" >&2; fi' EXIT
  local line pending="" changed=""
  spin_start "starting sbt"
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      # sbt narrates its watch at info level whatever level it was started at, so the narration
      # is dropped here; the triggering file's name is kept for the spinner's label.
      "[info] Build triggered by "*)
        changed="${line#\[info\] Build triggered by }"
        changed="${changed%%. Running *}"
        changed="${changed##*/}"
        continue
        ;;
      "[info] "*"Monitoring source files for "* | "[info]    Press <enter> to interrupt"* | "[success] Total time:"*)
        continue
        ;;
      "eezo dev: building")
        DEV_STATUS=""
        spin_stop
        spin_start "compiling${changed:+ ($changed changed)}"
        changed=""
        continue
        ;;
      "eezo dev: started "*)
        spin_stop
        dev_status "$DEV_WATCHING"
        continue
        ;;
      # sbt's summary of a failed task, after the diagnostics: "[error] (Compile / compile) ...".
      "[error] ("*") "*)
        spin_stop
        dev_say "✗ build failed; the previous build keeps serving. Fix it and save."
        dev_status "$DEV_WATCHING"
        continue
        ;;
      "[error] Total time:"*)
        continue
        ;;
    esac
    # A record header is held until its level line says whether the pair is noise.
    if [ -n "$pending" ]; then
      case "$line" in
        "INFO: "* | "CONFIG: "* | "FINE: "*)
          pending=""
          continue
          ;;
        *)
          dev_say "$pending"
          pending=""
          ;;
      esac
    fi
    if [[ $line =~ $JUL_NOISE ]]; then
      pending="$line"
      continue
    fi
    dev_say "$line"
  done
}

dev_legacy() {
  set +e
  sbt_at -warn eezoDev 2>&1 | dev_console
  local code="${PIPESTATUS[0]}"
  set -e
  exit "$code"
}

# ---------------------------------------------------------------------------------------------
# deploy — design/cli.md records the ordering. The short version: `fly.toml` carries
# `release_command = 'db migrate --apply'`, so Fly runs the migrations in a one-off machine with the
# NEW image before any machine is updated; a nonzero exit stops the deployment and the old version
# keeps serving. Migration ordering correctness comes from the platform, not from this script.
# ---------------------------------------------------------------------------------------------

FLY=""

need_fly() {
  FLY="$(command -v fly || command -v flyctl || true)"
  [ -n "$FLY" ] || {
    cat >&2 <<'MSG'
✗ eezo deploy needs the Fly CLI.

Install it (https://fly.io/docs/flyctl/install/), then authenticate:

    fly auth login
MSG
    exit 1
  }
  "$FLY" auth whoami > /dev/null 2>&1 || {
    cat >&2 <<'MSG'
✗ Fly authentication is not available.

Run:

    fly auth login

In CI, provide a deploy token through the FLY_API_TOKEN environment variable instead.
MSG
    exit 1
  }
}

toml_value() { # toml_value <key> — first `key = 'value'` in fly.toml, quotes stripped
  sed -n "s/^$1[[:space:]]*=[[:space:]]*[\"']\\{0,1\\}\\([^\"']*\\).*/\\1/p" fly.toml | head -1
}

# The generated fly.toml is the user's file: committed, editable, never rewritten unless deleted.
# It carries only eezo's happy path — the release command, the service on the scaffold's port, and
# the framework health check. Never secrets: those live in `fly secrets`, nowhere else.
write_fly_toml() {
  local name="$1" region="$2"
  {
    echo "# Generated by eezo deploy. Yours to edit; eezo rewrites it only if you delete it."
    echo "app = '$name'"
    [ -n "$region" ] && echo "primary_region = '$region'"
    cat <<'TOML'

[deploy]
  # Runs in a one-off machine with the NEW image, before any app machine is updated. A nonzero
  # exit stops the deployment and the old version keeps serving — this is eezo's migration
  # ordering: the schema converges before new code takes traffic.
  release_command = 'db migrate --apply'

[http_service]
  # Must match the app's `port` (EezoApp default: 8080).
  internal_port = 8080
  force_https = true
  auto_stop_machines = 'stop'
  auto_start_machines = true
  min_machines_running = 0

  [[http_service.checks]]
    grace_period = '10s'
    interval = '15s'
    timeout = '5s'
    method = 'GET'
    path = '/eezo/health'
TOML
  } > fly.toml
}

deploy() {
  local target="fly" app=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --fly) target="fly"; shift ;;
      --target) target="$2"; shift 2 ;;
      --target=*) target="${1#*=}"; shift ;;
      --app) app="$2"; shift 2 ;;
      --app=*) app="${1#*=}"; shift ;;
      *) echo "eezo: unknown deploy option '$1'" >&2; exit 1 ;;
    esac
  done

  if [ "$target" != "fly" ]; then
    {
      echo "✗ unsupported deployment target: $target"
      echo
      echo "supported targets:"
      echo "    fly"
    } >&2
    exit 1
  fi

  need_sbt
  need_fly

  # First deploy: let `fly launch` create the app and pick the nearest region — that detection is
  # Fly's, not something eezo should reimplement — then replace its generated config with eezo's.
  if [ ! -f fly.toml ]; then
    echo "→ first deploy: creating the Fly app"
    if [ -n "$app" ]; then
      "$FLY" launch --no-deploy --yes --name "$app"
    elif [ -t 0 ]; then
      "$FLY" launch --no-deploy --yes
    else
      echo "✗ first deploy in a non-interactive session needs --app <name>" >&2
      exit 1
    fi
    [ -f fly.toml ] || { echo "✗ fly launch did not write fly.toml" >&2; exit 1; }
    local name region
    name="$(toml_value app)"
    region="$(toml_value primary_region)"
    [ -n "$name" ] || { echo "✗ could not read the app name from fly.toml" >&2; exit 1; }
    write_fly_toml "$name" "$region"
    echo "→ wrote fly.toml (app: $name${region:+, region: $region})"
  fi

  # The one reliable secret preflight: an app with migrations will run `db migrate --apply` on
  # deploy, which needs a database. Names only — secret values never reach this machine.
  if [ -d db/migrations ] && [ -n "$(ls db/migrations 2> /dev/null)" ]; then
    if ! "$FLY" secrets list 2> /dev/null | grep -qE '(DATABASE_URL|EEZO_DB_URL)'; then
      cat >&2 <<'MSG'
✗ deployment cannot continue: no database secret is set.

This app has migrations, and `db migrate --apply` runs during deploy. Set the
database secret first:

    fly secrets set DATABASE_URL=postgres://user:password@host/dbname

(eezo also understands EEZO_DB_URL / EEZO_DB_USER / EEZO_DB_PASS.)
MSG
      exit 1
    fi
  fi

  local staged=0
  run_captured "staging the application" sbt_cmd eezoStage || staged=$?
  replay_captured ''
  [ "$staged" -eq 0 ] || {
    echo "✗ build failed; deployment was not attempted" >&2
    exit 1
  }
  [ -f target/eezo/stage/Dockerfile ] || {
    echo "✗ staging produced no Dockerfile at target/eezo/stage" >&2
    exit 1
  }

  # Fly's output is streamed on purpose: the release command's (migration) output is in it, and
  # that is exactly what a failed deploy needs on screen.
  echo "→ deploying to Fly (migrations run before the new version takes traffic)"
  # --config as an absolute path: fly resolves a relative one against the working-directory
  # argument (the stage dir), not against the shell's cwd — found the hard way on first contact.
  "$FLY" deploy target/eezo/stage --config "$PWD/fly.toml" || {
    {
      echo
      echo "✗ deployment failed; the previously deployed version, if any, is still serving."
      echo "  A migration failure stops the deploy before traffic switches. See the output"
      echo "  above, or: fly logs"
    } >&2
    exit 1
  }

  local url
  url="https://$(toml_value app).fly.dev"
  echo "→ waiting for health at $url/eezo/health"
  for _ in $(seq 1 45); do
    if curl -fsS -o /dev/null --max-time 5 "$url/eezo/health" 2> /dev/null; then
      echo
      echo "✓ deployed and healthy"
      echo
      echo "  $url"
      return 0
    fi
    sleep 2
  done
  {
    echo "✗ the app did not become healthy within 90 seconds."
    echo "  Check: fly logs"
  } >&2
  exit 1
}

# ---------------------------------------------------------------------------------------------
# upgrade — the installer again, which asks Maven Central for the latest release, records it and
# replaces this script; then the project in the current directory, if there is one, is moved to
# that release. The installer swaps the script in with a rename, so the bash reading this file
# keeps the old inode and finishes cleanly.
# ---------------------------------------------------------------------------------------------

EEZO_SITE="${EEZO_SITE:-https://eezo.io}"

upgrade() {
  if [ -f "$ROOT/.eezo-version" ]; then
    echo "eezo: this launcher runs from a checkout of the repository, and its version is whatever" >&2
    echo "\`sbt publishLocalForExample\` published last. Run that at $ROOT to move it." >&2
    exit 1
  fi
  local before after
  before="$(grep '^version=' "${EEZO_HOME:-$HOME/.eezo}/eezo-version" 2> /dev/null | cut -d= -f2-)"
  curl -fsSL "$EEZO_SITE/install" | bash
  after="$(grep '^version=' "${EEZO_HOME:-$HOME/.eezo}/eezo-version" | cut -d= -f2-)"
  [ -n "$after" ] || { echo "eezo: the installer recorded no version" >&2; exit 1; }
  if [ -f build.sbt ] && grep -q '"io.eezo"' build.sbt; then
    bump_project "$after"
  fi
  if [ "$before" = "$after" ]; then
    echo "eezo $after is the latest release; the command line is up to date."
  else
    echo "eezo ${before:-?} -> $after"
  fi
}

# Rewrites the version on every eezo dependency and on the sbt plugin line in the current
# project. Only lines that name an io.eezo artifact with a quoted version are touched, written
# through a temporary file because sed -i is spelled differently on macOS and Linux.
bump_project() { # <version>
  local version="$1" file changed=0
  for file in build.sbt project/plugins.sbt; do
    [ -f "$file" ] || continue
    sed -E \
      -e "s/(\"io\.eezo\" *%% *\"eezo[a-z-]*\" *% *)\"[^\"]+\"/\1\"$version\"/g" \
      -e "s/(\"io\.eezo\" *% *\"sbt-eezo\" *% *)\"[^\"]+\"/\1\"$version\"/g" \
      "$file" > "$file.eezo-upgrade"
    if cmp -s "$file" "$file.eezo-upgrade"; then
      rm -f "$file.eezo-upgrade"
    else
      mv "$file.eezo-upgrade" "$file"
      echo "updated $file to eezo $version"
      changed=1
    fi
  done
  [ "$changed" -eq 1 ] || echo "the project in $PWD is already on eezo $version"
}

read_version_file() {
  local installed="${EEZO_HOME:-$HOME/.eezo}/eezo-version"
  if [ -f "$ROOT/.eezo-version" ]; then
    # A checkout: the locally published version, and the sbt the examples build pins.
    VERSION_FILE="$ROOT/.eezo-version"
    SBT_VERSION="$(grep '^sbt.version=' "$ROOT/examples/project/build.properties" | cut -d= -f2-)"
  elif [ -f "$installed" ]; then
    # An installed launcher: the released version the installer recorded.
    VERSION_FILE="$installed"
    SBT_VERSION="$(grep '^sbt.version=' "$VERSION_FILE" | cut -d= -f2-)"
  else
    echo "eezo: no version file at $ROOT/.eezo-version or $installed." >&2
    echo "Install the command line with \`curl -fsSL https://eezo.io/install | bash\`, or run" >&2
    echo "\`sbt publishLocalForExample\` at the eezo repository root and use bin/eezo from there." >&2
    exit 1
  fi
  EEZO_VERSION="$(grep '^version=' "$VERSION_FILE" | cut -d= -f2-)"
  SCALA_VERSION="$(grep '^scalaVersion=' "$VERSION_FILE" | cut -d= -f2-)"
  JDK_FLOOR="$(grep '^jdkFloor=' "$VERSION_FILE" | cut -d= -f2-)"
  [ -n "$EEZO_VERSION" ] && [ -n "$SCALA_VERSION" ] && [ -n "$JDK_FLOOR" ] && [ -n "$SBT_VERSION" ] || {
    echo "eezo: $VERSION_FILE is missing one of version, scalaVersion, jdkFloor, sbt.version." >&2
    exit 1
  }
}

# The scaffold's gitignore entries, either written to a new .gitignore file or appended if .gitignore
# already exists, in which case it names the entries it appended
write_gitignore() { # <file>
  local file="$1" existed=0 line added=()
  [ ! -f "$file" ] || existed=1
  for line in target/ .bsp/ .metals/ .bloop/; do
    [ "$existed" -eq 1 ] && grep -qxF "$line" "$file" && continue
    added+=("$line")
  done
  [ "${#added[@]}" -gt 0 ] || return 0
  if [ -s "$file" ] && [ -n "$(tail -c1 "$file")" ]; then echo >> "$file"; fi
  printf '%s\n' "${added[@]}" >> "$file"
  [ "$existed" -eq 0 ] || echo "added ${added[*]} to the existing .gitignore"
}

scaffold() {
  # One name and, anywhere beside it, `--tailwind`: the scaffold then writes a `tailwind.css` at
  # the root, which is what turns the plugin's stylesheet generator on, and links the stylesheet
  # from the one page it writes. The file is the switch; the flag only writes it.
  local dir="" tailwind=0 arg
  for arg in "$@"; do
    case "$arg" in
      --tailwind) tailwind=1 ;;
      --*) echo "eezo: new does not know the flag '$arg'; it takes a name and --tailwind" >&2; exit 1 ;;
      *)
        [ -z "$dir" ] || { echo "eezo: new takes one name, got '$dir' and '$arg'" >&2; exit 1; }
        dir="$arg"
        ;;
    esac
  done
  [ -n "$dir" ] || { echo "eezo: new needs a name: eezo new myapp, or eezo new . for the current directory ($(basename "$PWD"))" >&2; exit 1; }
  # Any reference to the current directory such as: ./, "$PWD", or a symlink to it
  if [ "$dir" -ef . ]; then dir="."; fi
  if [ "$dir" = "." ]; then
    # In place: the app is named after the directory
    name="$(basename "$PWD")"
    local existing=() file
    for file in build.sbt build.sc build.mill project src; do
      [ ! -e "$file" ] && [ ! -L "$file" ] || existing+=("$file")
    done
    [ "${#existing[@]}" -eq 0 ] || {
      echo "eezo: this directory already has ${existing[*]}; new scaffolds a project only where there is none" >&2
      exit 1
    }
    [ ! -L .gitignore ] || {
      echo "eezo: .gitignore here is a symlink; new appends its entries only to a plain .gitignore" >&2
      exit 1
    }
    [ ! -e .gitignore ] || { [ -f .gitignore ] && [ -r .gitignore ] && [ -w .gitignore ]; } || {
      echo "eezo: .gitignore here is not a file new can append to; make it a writable file or remove it" >&2
      exit 1
    }
  else
    name="$dir"
    [ ! -e "$dir" ] || { echo "eezo: ./$dir already exists" >&2; exit 1; }
  fi
  read_version_file

  mkdir -p "$dir/project" "$dir/src/main/scala/app" "$dir/src/main/scala/models"

  cat > "$dir/project/build.properties" <<EOF
sbt.version=$SBT_VERSION
EOF

  cat > "$dir/project/plugins.sbt" <<EOF
// The route table generator: scans src/main/scala/app/ and your models into
// io.eezo.generated.Routes, and provides the eezo* tasks (eezoDev, eezoStatus, ...).
addSbtPlugin("io.eezo" % "sbt-eezo" % "$EEZO_VERSION")
EOF

  cat > "$dir/build.sbt" <<EOF
name         := "$name"
scalaVersion := "$SCALA_VERSION"

enablePlugins(EezoPlugin)

libraryDependencies += "io.eezo" %% "eezo" % "$EEZO_VERSION"

scalacOptions ++= Seq("-release", "$JDK_FLOOR", "-deprecation", "-feature", "-unchecked", "-no-indent")

// eezo needs a modern JDK to run (virtual threads without pinning), so the app forks.
run / fork           := true
run / outputStrategy := Some(OutputStrategy.StdoutOutput)
EOF

  cat > "$dir/src/main/scala/Main.scala" <<'EOF'
import io.eezo.EezoApp
import io.eezo.db.Schema
import io.eezo.generated.Routes
import io.eezo.http.RouteTable

/** The whole entry point. `main` is inherited and dispatches: `sbt run` serves on port 8080,
  * `eezo dev` adds the drift check and restart-on-save, and `eezo db status|sync|freeze|migrate`
  * are the schema commands.
  *
  * `schema` is abstract on `EezoApp`, so an application on the umbrella always says what it has,
  * and a new one has no tables yet. When you add a model with `derives Table`, declare it in a
  * Schema and name that here instead of `Schema.empty`:
  *
  * {{{
  * object AppSchema extends Schema { val things = table[Thing] }
  * // and in Main:  override def schema: Schema = AppSchema
  * }}}
  */
object Main extends EezoApp {
  override def schema: Schema     = Schema.empty
  override def routes: RouteTable = Routes.table()
}
EOF

  if [ "$tailwind" -eq 1 ]; then
    cat > "$dir/tailwind.css" <<'EOF'
/* The stylesheet eezo builds. The sbt plugin sees this file at the project root and runs the
   Tailwind CLI over it on every build, writing assets/tailwind.css into the jar; nothing here is
   committed but this file. source("src") keeps the scan to the sources. The how-to "Style with
   Tailwind" in the docs has the rest. */
@import "tailwindcss" source("src");
EOF
    cat > "$dir/src/main/scala/app/Index.scala" <<'EOF'
package app

import io.eezo.core.html.*
import io.eezo.http.Assets
import io.eezo.http.Request
import io.eezo.http.Response

/** `app/Index.scala` mounts `GET /`, calling `def index`: the filename is the route.
  *
  * The stylesheet is the one the build writes from `tailwind.css` at the project root, linked
  * under the versioned address `Assets.url` gives it. Once the application has a second page, the
  * link moves into a `Layout` named in `Main`, so every page gets it.
  */
object Index {

  def index(request: Request): Response = {
    val _ = request
    Response.Ok(
      Html.doctype ++ html(
        head(
          meta(Attrs.charset := "utf-8"),
          title("eezo"),
          link(Attrs.rel := "stylesheet", Attrs.href := Assets.url("tailwind.css"))
        ),
        body(
          Attrs.cls := "mx-auto max-w-xl p-8 font-sans text-stone-800",
          h1(Attrs.cls := "text-3xl font-semibold", "it works"),
          p(Attrs.cls := "mt-4", "Add a case class with ", code("derives Form, Resource"), " under models/ "),
          p("and it mounts seven CRUD routes. ", code("eezo routes"), " lists them.")
        )
      )
    )
  }
}
EOF
  else
    cat > "$dir/src/main/scala/app/Index.scala" <<'EOF'
package app

import io.eezo.core.html.*
import io.eezo.http.Request
import io.eezo.http.Response

/** `app/Index.scala` mounts `GET /`, calling `def index` — the filename is the route. */
object Index {

  def index(request: Request): Response = {
    val _ = request
    Response.Ok(
      Html.doctype ++ html(
        head(meta(Attrs.charset := "utf-8"), title("eezo")),
        body(
          h1("it works"),
          p("Add a case class with ", code("derives Form, Resource"), " under models/ "),
          p("and it mounts seven CRUD routes. ", code("eezo routes"), " lists them.")
        )
      )
    )
  }
}
EOF
  fi

  echo "created $name at $(cd -- "$dir" 2> /dev/null && pwd) (eezo $EEZO_VERSION, Scala $SCALA_VERSION, sbt $SBT_VERSION)"
  write_gitignore "$dir/.gitignore"
  echo
  echo "next:"
  [ "$dir" = "." ] || echo "  cd $name"
  echo "  eezo dev           # serve on :8080, restart on save"
  [ "$tailwind" -eq 0 ] || echo "                     # the first build fetches the Tailwind CLI once, into ~/.eezo/tools"
  echo "  eezo routes        # what is mounted"
}

cmd="${1:-}"
case "$cmd" in
  "" | -h | --help)
    usage
    ;;
  new)
    shift
    scaffold "$@"
    ;;
  dev)
    dev
    ;;
  build)
    need_sbt
    forward "staging the application" eezoStage
    ;;
  deploy)
    shift
    deploy "$@"
    ;;
  upgrade)
    upgrade
    ;;
  # The schema commands, one namespace forwarded whole: `eezo db sync --apply` is
  # `run db sync --apply`, and `eezo db` alone is the application's own list of them.
  # `db freeze` bypasses the spinner: it prompts on destructive changes, and a prompt behind a
  # spinner is a hang with good intentions.
  db)
    need_sbt
    if [ "${2:-}" = "freeze" ]; then
      forward_live "run $*"
    else
      forward "eezo db ${2:-}" "run $*"
    fi
    ;;
  routes | help)
    need_sbt
    forward "eezo $cmd" "run $*"
    ;;
  status | sync | freeze | migrate | reset | drop | dump | ddl)
    echo "eezo: the schema commands live under db: eezo db $*" >&2
    exit 1
    ;;
  *)
    echo "eezo: unknown command '$cmd'" >&2
    usage >&2
    exit 1
    ;;
esac
